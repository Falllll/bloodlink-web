# Alamat Laravel. Hanya dibaca di server; JANGAN diberi awalan NEXT_PUBLIC_.
API_BASE_URL=http://localhost:8000/api/v1

# Reverb (WebSocket). Kunci app ini publik by design -- ia kunci klien, bukan
# secret; REVERB_APP_SECRET tetap di backend. Cocokkan dengan REVERB_APP_KEY,
# REVERB_PORT, dan REVERB_SCHEME backend. Tidak ada cluster: Reverb bukan Pusher Cloud.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
# public_id (UUID) fasilitas tujuan chat landing page; kosong = peluncur chat tidak dirender.
CHAT_FACILITY_ID=
